# 生产环境环境变量（复制为 .env.prod 后填值）
# 注意：.env.prod 里有密钥，**不要提交到 git**（.gitignore 已包含）

# ===== LLM（必填，否则文案生成会退化成模板兜底）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ===== 存储 =====
# 单机用 json；要多实例请起 MySQL 并改成 mysql
STORE_BACKEND=json

# ===== 检索 =====
# 不启 Milvus 时留空 -> 自动走本地 TF-IDF 降级
MILVUS_URI=
RETRIEVAL_MIN_SCORE=0.05
# 精排：模型文件不在镜像里，缺失时会 fail-open 保持召回顺序，不影响可用性
RAG_RERANK=1
# LLM 语义复核（多一次模型调用，可关）
RAG_LLM_JUDGE=1
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# ===== 投放（无平台授权前必须 mock）=====
QIANCHUAN_DELIVERY_MODE=mock

# ===== 图文/视频 =====
IMAGE_PROVIDER=local
VIDEO_PROVIDER=kling
VIDEO_API_KEY=

# ===== 鉴权 =====
# 生产环境务必改掉默认演示账号密码
DASHBOARD_DEMO_PASSWORD=

# ===== 时区 =====
TZ=Asia/Shanghai
