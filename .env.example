# ===== 基础设施配置 =====(注意端口可能变动)
MILVUS_HOST=192.168.198.131
MILVUS_PORT=19530
MILVUS_URI=http://192.168.198.131:19530
MILVUS_TIMEOUT=5
REDIS_HOST=192.168.198.131
REDIS_PORT=16379
REDIS_URL=redis://192.168.198.131:16379/0

# ===== 文案生成 Agent（文案广告 · 大模型文本 API）=====
# 文案 Agent 用此文本大模型生成文案
# LLM_BASE_URL 填 API 域名（如 https://api.deepseek.com）；切勿填网页控制台域名 platform.deepseek.com，否则会被 WAF 拦截返回 429
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ===== 图文生成 Agent（图文广告 · 独立文生图 API）=====
# IMAGE_PROVIDER=local（默认）时使用本地 playwright 渲染海报，无需配置 Key；
# IMAGE_PROVIDER=dashscope 时调用独立的第三方文生图 API（阿里云百炼通义万相）
#   IMAGE_API_BASE_URL 填文生图 endpoint：https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis
#   IMAGE_API_MODEL    如 wanx2.1-t2i-turbo / wanx2.1-t2i-plus
#   充值中心页面的点数即对应此独立 API 的账户额度（后端为 Mock 记账）
IMAGE_PROVIDER=local
IMAGE_API_KEY=***
IMAGE_API_BASE_URL=
IMAGE_API_MODEL=wanx2.1-t2i-turbo
IMAGE_API_SIZE=1024*1024
IMAGE_POLL_INTERVAL=5
IMAGE_POLL_TIMEOUT=300

# ===== 视频生成 Agent（视频广告 · 独立图生视频第三方 API）=====
# VIDEO_PROVIDER 支持 kling（可灵，默认）与 aliyun（阿里云百炼 DashScope）
#   kling ：VIDEO_API_BASE_URL 填 API 根地址，VIDEO_API_MODEL 如 kling-v1
#   aliyun：VIDEO_API_BASE_URL 填完整的 video-synthesis endpoint；
#           VIDEO_API_MODEL 必须填百炼上部署的【图生视频】模型（如 wan2.5-i2v-plus / wanx2.1-i2v-turbo），
#           不要填 videoedit 类模型（其要求 input.media 源视频，不适配本模块的「图片→视频」流程）
VIDEO_PROVIDER=kling
VIDEO_API_KEY=***
VIDEO_API_BASE_URL=https://api-beijing.klingai.com
VIDEO_API_MODEL=kling-v1
VIDEO_DURATION=10
VIDEO_POLL_INTERVAL=5
VIDEO_POLL_TIMEOUT=300

# ===== 抖音 · 巨量千川（广告投递 Agent · 独立 MCP 工具）=====
# MCP 工具源码位于 mcp_servers/douyin/（按平台分目录，与拼多多等互不影响）
# 启动 MCP Server：python mcp_servers/douyin/server.py
# 巨量引擎开放平台「我的应用」中可查到 App ID / Secret；OAuth2 授权后拿到 access_token
QIANCHUAN_APP_ID=
QIANCHUAN_APP_SECRET=
QIANCHUAN_ACCESS_TOKEN=***
QIANCHUAN_REFRESH_TOKEN=
# 千川广告主账户 ID（投递主体，可由「获取已授权账号列表」接口获得）
QIANCHUAN_ADVERTISER_ID=
# 巨量引擎开放平台网关
QIANCHUAN_BASE_URL=https://api.oceanengine.com
# mock：仅预检 + 返回模拟计划（无需真实授权，便于联调）；real：真实调用创编接口
QIANCHUAN_DELIVERY_MODE=mock
# 创编（投放）接口 path，按巨量官方文档填写
QIANCHUAN_CREATE_PLAN_PATH=/open_api/v1.0/qianchuan/ad/create/
QIANCHUAN_TIMEOUT=30

# ===== MCP 服务配置 =====
ERP_BASE_URL=https://mock-erp.example.com/api
ERP_API_KEY=mock_key
OCEANENGINE_APP_KEY=mock_key
OCEANENGINE_APP_SECRET=mock_secret

#HF_ENDPOINT 镜像
HF_ENDPOINT=https://hf-mirror.com

#向量模型配置
OPENAI_BASE_URL=
OPENAI_API_KEY=
EMBEDDING_MODEL=
# ===== 向量化 Embedding（文案 Agent 的相似案例检索用）=====
# 复用 OpenAI 兼容端点做文本向量化；留空会退回 HuggingFace 本地模型（首次会下载大模型而阻塞）
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
# 单次向量化请求的最大条数（部分在线服务有限制，如阿里云 text-embedding-v4 建议 10；超限会自动二分重试）
EMBEDDING_BATCH_SIZE=10

#
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080