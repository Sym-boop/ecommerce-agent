# ===== 基础设施配置 =====
MILVUS_URI=http://192.168.26.129:19530
MILVUS_TOKEN=

# ===== 大模型 API 配置 =====
# DeepSeek Chat（用于文案/定价生成）
LLM_API_KEY=sk-xxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# DeepSeek Embedding（用于向量检索，与 LLM 同一 key 即可）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx

# 备选：OpenAI 兼容 embedding
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# EMBEDDING_MODEL=text-embedding-3-small

# 备选：本地 BGE-M3（无需 API key，需安装 langchain-huggingface）
# BGE_MODEL_NAME=BAAI/bge-m3

# ===== Redis（Celery 队列）=====
REDIS_HOST=192.168.26.129
REDIS_PORT=16379

# ===== MCP 服务配置 =====
ERP_BASE_URL=https://mock-erp.example.com/api
ERP_API_KEY=mock_key
OCEANENGINE_APP_KEY=mock_key
OCEANENGINE_APP_SECRET=mock_secret
